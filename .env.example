# LOCAL DEVELOPMENT 

# DATABASE_URL=jdbc:mysql://localhost:3306/sistemppa
# DATABASE_USER=root
# DATABASE_PASSWORD=JASSPPA@2000


# PRODUCTION - Railway.app

# Set these in Railway.app Variables dashboard
# DATABASE_URL=jdbc:mysql://mysql-container:3306/sistemppa
# DATABASE_USER=root
# DATABASE_PASSWORD=<railway-mysql-auto-generated-password>

# Or use Railway MySQL auto-provided:
# DATABASE_URL=<value from Railway DATABASE_PUBLIC_URL>
# DATABASE_USER=<rails to extract from URL>
# DATABASE_PASSWORD=<rails to extract from URL>


# PRODUCTION - AWS RDS

# DATABASE_URL=jdbc:mysql://sistemppa-db.xxxxx.amazonaws.com:3306/sistemppa
# DATABASE_USER=admin
# DATABASE_PASSWORD=<strong-rds-password>


# PRODUCTION - Google Cloud SQL

# DATABASE_URL=jdbc:mysql://35.123.45.67:3306/sistemppa
# DATABASE_USER=root
# DATABASE_PASSWORD=<gcp-cloud-sql-password>


# APPLICATION SETTINGS

# PORT=8080 (Railway/Cloud will set this automatically)
# APP_ENV=production
# LOG_LEVEL=INFO


# SECURITY (Optional - for future enhancements)

# JWT_SECRET=your-secret-key-min-32-chars
# SESSION_TIMEOUT=1800 (30 minutes in seconds)
# ENABLE_2FA=false
